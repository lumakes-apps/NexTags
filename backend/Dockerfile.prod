FROM python:3.11-slim

# 套件在建置 image 時就裝進 /app/.venv，啟動時直接執行，不再經過 `uv run`。
# 以前 `uv run` 啟動時發現 .python-version（3.10）與 venv（3.11）不符，會下載 Python 3.10、
# 重建 venv 並重新編譯 crcmod/r128gain；磁碟滿時後端因此無法啟動。
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.11 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# 安裝系統依賴，包括 FFmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# 創建非 root 用戶，使用與主機相同的 UID/GID
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} appuser || groupmod -g ${GROUP_ID} appuser
RUN useradd -u ${USER_ID} -g appuser -m -s /bin/bash appuser || usermod -u ${USER_ID} -g ${GROUP_ID} appuser
RUN chown appuser:appuser /app

COPY --chmod=755 entrypoint.sh /entrypoint.sh

# 直接以 appuser 安裝與複製，避免最後再 chown -R 整個 /app（會把 venv 再複製一層）
USER appuser

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=appuser:appuser . .

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
