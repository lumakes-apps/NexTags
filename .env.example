MUSIC_ROOT_PATH=

# 整合密鑰的主金鑰（Fernet）。在設定頁「整合」儲存的密碼與金鑰會以它加密存入資料庫。
# 產生方式：python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 更換或遺失後，已儲存的密鑰無法解密，需重新輸入。
NEXTAGS_SECRET_KEY=

# 選填：AI 歌詞金鑰也可在設定頁填寫；這裡有值時優先使用
ANTHROPIC_TOKEN=

# Redis 設定
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# SQLite 設定 (選填，預設: /app/data/musicmanager.db)
# SQLITE_DB_PATH=